#!/bin/sh
set -eu
case "${1:-}" in
  setup) uv sync --dev ;;
  fmt) uv run ruff format src tests ;;
  lint)
    uv run ruff format --check src tests
    uv run ruff check src tests ;;
  test) PYTEST_DISABLE_PLUGIN_AUTOLOAD=1 uv run pytest -q ;;
  check)
    "$0" lint
    "$0" test ;;
  verify) uv run ai-kit verify ;;
  *)
    echo "usage: ./dev {setup|fmt|lint|test|check|verify}" >&2
    exit 2 ;;
esac
