#!/usr/bin/env python3
"""Project commands shared by Windows, Linux and CI."""

import os
import shutil
import subprocess
import sys
from pathlib import Path

os.chdir(Path(__file__).resolve().parent)


def uv(*args):
    executable = shutil.which("uv")
    command = [executable] if executable else [sys.executable, "-m", "uv"]
    result = subprocess.run([*command, *args])
    if result.returncode:
        sys.exit(result.returncode)


def check():
    uv("run", "ruff", "format", "--check", "src", "tests", "dev")
    uv("run", "ruff", "check", "src", "tests", "dev")
    uv("run", "pytest", "-q")


os.environ["PYTEST_DISABLE_PLUGIN_AUTOLOAD"] = "1"
action = sys.argv[1] if len(sys.argv) == 2 else ""
if action == "setup":
    uv("sync", "--dev")
elif action == "fmt":
    uv("run", "ruff", "format", "src", "tests", "dev")
elif action == "lint":
    uv("run", "ruff", "check", "src", "tests", "dev")
elif action == "test":
    uv("run", "pytest", "-q")
elif action == "check":
    check()
elif action == "verify":
    check()
    uv("lock", "--check")
    uv("run", "ai-kit", "sync", "--check")
    uv("run", "ai-kit", "doctor")
else:
    print("usage: ./dev {setup|fmt|lint|test|check|verify}", file=sys.stderr)
    sys.exit(2)
